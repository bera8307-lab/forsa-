GOOGLE_MAPS_API_KEY=ta_cle_google_maps

# Nécessaire pour la génération de CV et de lettres de motivation par l'IA.
# Clé API Groq (console.groq.com) : garde-la uniquement ici, jamais
# dans le code ni côté navigateur.
GROQ_API_KEY=ta_cle_groq
# Optionnel : laisse cette ligne en commentaire, le code utilise déjà llama-3.3-70b-versatile.
# (Ne mets pas un modèle « prompt-guard » : ce n'est pas un modèle qui écrit du texte.)
# GROQ_MODEL=llama-3.3-70b-versatile

# Envoi d'emails : candidatures + codes de vérification / mot de passe oublié.
#
# A) EN LIGNE (Render, etc.) : API Brevo en HTTPS (gratuit, 300 emails/jour). Les hébergeurs
#    gratuits bloquent le SMTP, donc c'est la seule option qui marche là-bas.
#    Brevo > SMTP & API > API Keys > Generate. SMTP_FROM = une adresse expéditeur vérifiée dans Brevo.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
# SMTP_FROM=ton.adresse@gmail.com
#
# B) SUR TON PC : SMTP Gmail (laisse BREVO_API_KEY en commentaire).
# Gmail : active la validation en 2 étapes puis crée un "mot de passe d'application"
# (https://myaccount.google.com/apppasswords). N'utilise PAS ton mot de passe normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.adresse@gmail.com
SMTP_PASSWORD=mot_de_passe_application_gmail
# Optionnel : adresse affichée comme expéditeur (par défaut = SMTP_USER)
# SMTP_FROM=ton.adresse@gmail.com

# Base de données Supabase (Postgres).
# Supabase > ton projet > bouton « Connect » > « Session pooler » : copie la chaîne et
# remplace [YOUR-PASSWORD] par le mot de passe de la base. Si le mot de passe contient
# des caractères spéciaux (@ : / ? # %), encode-les (ex. @ -> %40).
DATABASE_URL=postgresql://postgres.xxxxxxxx:ton_mot_de_passe@aws-0-ta-region.pooler.supabase.com:5432/postgres
